---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "OLIMIND lab — The Business Evolution Lab",
  description = "Diseño, estrategia e inteligencia artificial para ayudar a pequeñas empresas a evolucionar con claridad y propósito.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body><slot /></body>
</html>

<style is:global>
  :root {
    --paper: #f4f2eb;
    --ink: #141714;
    --green: #5c786f;
    --green-deep: #263c36;
    --green-soft: #c9d1cb;
    --yellow: #f4c800;
    --line: rgba(20, 23, 20, 0.18);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Montserrat", "Avenir Next", "Helvetica Neue", Arial, sans-serif; font-size: 16px; line-height: 1.5; }
  a { color: inherit; text-decoration: none; }
  button, input, textarea { font: inherit; }
  img { display: block; max-width: 100%; }
  ::selection { background: var(--yellow); color: var(--ink); }

  .site-header { align-items: center; display: grid; grid-template-columns: 1fr auto 1fr; height: 108px; left: 0; padding: 0 clamp(24px, 4vw, 72px); position: absolute; right: 0; top: 0; z-index: 10; }
  .brand img { height: auto; width: clamp(150px, 14vw, 215px); }
  .desktop-nav { display: flex; gap: 36px; }
  .desktop-nav a, .header-cta { font-size: .72rem; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; }
  .desktop-nav a { position: relative; }
  .desktop-nav a::after { background: var(--yellow); bottom: -8px; content: ""; height: 2px; left: 0; position: absolute; transform: scaleX(0); transform-origin: left; transition: transform .25s ease; width: 100%; }
  .desktop-nav a:hover::after { transform: scaleX(1); }
  .header-cta { border-bottom: 1px solid var(--ink); justify-self: end; padding-bottom: 5px; }

  .hero { display: flex; flex-direction: column; justify-content: center; min-height: 100svh; overflow: hidden; padding: 140px clamp(24px, 7.5vw, 140px) 56px; position: relative; }
  .eyebrow, .section-label { font-size: .68rem; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; }
  .eyebrow { color: var(--green); margin: 0 0 34px; }
  .hero h1 { font-size: clamp(2.7rem, 6.2vw, 6.9rem); font-weight: 300; letter-spacing: -.055em; line-height: .98; margin: 0; max-width: 1200px; position: relative; z-index: 2; }
  .hero h1 span { color: var(--green); display: inline-block; position: relative; }
  .hero h1 span::after { background: var(--yellow); bottom: -.12em; content: ""; height: 7px; left: 1%; position: absolute; transform: rotate(-1.5deg) skewX(-24deg); width: 101%; }
  .hero-bottom { align-items: end; display: flex; justify-content: space-between; margin-top: 58px; position: relative; z-index: 2; }
  .hero-bottom > p { font-size: .69rem; font-weight: 600; letter-spacing: .17em; line-height: 1.9; margin: 0; }
  .circle-link { align-items: center; border: 1px solid var(--green); border-radius: 50%; display: flex; flex-direction: column; font-size: .65rem; height: 108px; justify-content: center; letter-spacing: .13em; text-transform: uppercase; transition: background .25s, color .25s; width: 108px; }
  .circle-link b { font-size: 1.2rem; font-weight: 300; margin-top: 8px; }
  .circle-link:hover { background: var(--green-deep); color: var(--paper); }
  .hero-orbit { border: 1px solid rgba(92,120,111,.25); border-radius: 50%; height: min(64vw, 820px); position: absolute; right: -14vw; top: 4vh; width: min(64vw, 820px); }
  .hero-orbit::before { border: 1px solid rgba(92,120,111,.12); border-radius: 50%; content: ""; inset: 13%; position: absolute; }
  .hero-orbit span { background: var(--yellow); border-radius: 50%; height: 12px; left: 10%; position: absolute; top: 18%; width: 12px; }
  .hero-index { bottom: 58px; color: var(--green); font-size: .63rem; left: 34px; letter-spacing: .15em; position: absolute; transform: rotate(-90deg); }
  .mobile-break { display: none; }

  .section-pad { padding: clamp(92px, 11vw, 180px) clamp(24px, 7.5vw, 140px); }
  .manifesto { border-top: 1px solid var(--line); display: grid; gap: 48px; grid-template-columns: 1fr 3fr; }
  .section-label { color: var(--green); margin: 0; }
  .manifesto-copy p { color: var(--green); font-size: clamp(1.15rem, 2vw, 1.8rem); font-weight: 300; margin: 0 0 22px; }
  .manifesto h2, .section-heading h2, .about h2, .contact h2 { font-size: clamp(2.25rem, 4.7vw, 5.1rem); font-weight: 300; letter-spacing: -.055em; line-height: 1.02; margin: 0; }
  .manifesto h2 em, .about h2 em { color: var(--green); font-style: normal; }
  .manifesto-note { font-size: .9rem; grid-column: 2; margin: 12px 0 0; max-width: 460px; }

  .services { background: var(--green-deep); color: var(--paper); }
  .section-heading { display: grid; gap: 36px; grid-template-columns: 1fr 3fr; margin-bottom: 90px; }
  .section-label.light { color: var(--green-soft); }
  .service-list { border-top: 1px solid rgba(244,242,235,.25); }
  .service { align-items: start; border-bottom: 1px solid rgba(244,242,235,.25); display: grid; gap: 28px; grid-template-columns: .45fr 1.3fr 1.4fr 1fr; padding: 42px 0; transition: padding .3s ease, color .3s ease; }
  .service:hover { color: var(--yellow); padding-left: 16px; }
  .service-number { color: var(--green-soft); font-size: .68rem; letter-spacing: .17em; }
  .service h3 { font-size: clamp(1.4rem, 2.2vw, 2.2rem); font-weight: 300; letter-spacing: -.035em; margin: -8px 0 0; }
  .service > p { color: var(--green-soft); font-size: .9rem; line-height: 1.75; margin: 0; max-width: 420px; }
  .service ul { list-style: none; margin: 0; padding: 0; }
  .service li { color: var(--green-soft); font-size: .72rem; letter-spacing: .05em; margin: 0 0 8px; }

  .split-heading h2 span { color: var(--green); }
  .project-list { border-top: 1px solid var(--line); }
  .project { align-items: center; border-bottom: 1px solid var(--line); display: grid; gap: 18px; grid-template-columns: .35fr 1.45fr 1fr .35fr .2fr; min-height: 132px; transition: background .25s, padding .25s; }
  .project:hover { background: rgba(92,120,111,.08); padding: 0 18px; }
  .project > span, .project time { color: var(--green); font-size: .68rem; letter-spacing: .14em; }
  .project h3 { font-size: clamp(1.4rem, 2.4vw, 2.5rem); font-weight: 300; letter-spacing: -.04em; margin: 0; }
  .project p { font-size: .75rem; letter-spacing: .06em; margin: 0; text-transform: uppercase; }
  .project b { font-size: 1.35rem; font-weight: 300; }

  .about { background: var(--ink); color: var(--paper); display: grid; gap: clamp(60px, 9vw, 150px); grid-template-columns: 1fr 1.5fr; overflow: hidden; }
  .about-mark { align-items: center; display: flex; justify-content: center; min-height: 560px; position: relative; }
  .about-mark span { color: var(--green); font-size: clamp(18rem, 34vw, 40rem); font-weight: 300; left: -24%; letter-spacing: -.15em; line-height: .7; position: absolute; }
  .about-mark i { border: 1px solid rgba(244,242,235,.35); border-radius: 50%; height: 170px; position: relative; width: 170px; }
  .about-mark i::after { background: var(--yellow); border-radius: 50%; content: ""; height: 11px; position: absolute; right: 11px; top: 35px; width: 11px; }
  .about-copy h2 { font-size: clamp(2.4rem, 4.3vw, 4.8rem); margin: 48px 0 58px; }
  .about-copy p:not(.section-label) { color: #b9c0bc; font-size: .95rem; line-height: 1.85; margin: 0 0 22px; max-width: 590px; }
  .about-copy a { border-bottom: 1px solid var(--yellow); display: inline-block; font-size: .72rem; letter-spacing: .12em; margin-top: 30px; padding-bottom: 7px; text-transform: uppercase; }

  .contact { display: grid; gap: 70px; grid-template-columns: .6fr 2fr; }
  .contact-intro { grid-column: 2; }
  .contact h2 span { color: var(--green); position: relative; }
  .contact h2 span::after { background: var(--yellow); bottom: -5px; content: ""; height: 5px; left: 0; position: absolute; transform: rotate(-2deg); width: 100%; }
  .contact-intro p { font-size: .9rem; line-height: 1.8; margin: 36px 0 0; max-width: 450px; }
  .contact-form { display: grid; gap: 36px 42px; grid-column: 2; grid-template-columns: 1fr 1fr; margin-top: 30px; }
  .contact-form label { color: var(--green); display: flex; flex-direction: column; font-size: .67rem; font-weight: 600; gap: 13px; letter-spacing: .14em; text-transform: uppercase; }
  .contact-form .full { grid-column: 1 / -1; }
  .contact-form input, .contact-form textarea { background: transparent; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; color: var(--ink); font-size: 1rem; outline: 0; padding: 12px 0 16px; resize: vertical; text-transform: none; }
  .contact-form input:focus, .contact-form textarea:focus { border-color: var(--green); }
  .contact-form button { align-items: center; background: var(--green-deep); border: 0; border-radius: 50%; color: var(--paper); cursor: pointer; display: flex; flex-direction: column; font-size: .68rem; height: 145px; justify-content: center; letter-spacing: .13em; margin-top: 16px; text-transform: uppercase; transition: background .25s, color .25s; width: 145px; }
  .contact-form button:hover { background: var(--yellow); color: var(--ink); }
  .contact-form button span { font-size: 1.2rem; margin-top: 8px; }

  footer { background: var(--green-deep); color: var(--paper); padding: 76px clamp(24px, 7.5vw, 140px) 36px; }
  footer > img { filter: brightness(0) invert(1); height: auto; opacity: .92; width: min(680px, 70vw); }
  footer > p { color: var(--green-soft); font-size: .68rem; letter-spacing: .2em; margin: 40px 0 70px; }
  footer > div { border-top: 1px solid rgba(244,242,235,.2); display: flex; font-size: .68rem; justify-content: space-between; letter-spacing: .08em; padding-top: 24px; text-transform: uppercase; }

  @media (max-width: 820px) {
    .site-header { grid-template-columns: 1fr auto; height: 86px; }
    .desktop-nav { display: none; }
    .header-cta { font-size: .62rem; }
    .hero { justify-content: flex-end; padding-bottom: 38px; }
    .hero h1 { font-size: clamp(2.55rem, 11vw, 4.5rem); line-height: 1.03; }
    .hero-orbit { height: 92vw; right: -38vw; top: 17vh; width: 92vw; }
    .hero-bottom { align-items: start; flex-direction: column; gap: 40px; margin-top: 44px; }
    .circle-link { align-self: flex-end; height: 88px; width: 88px; }
    .hero-index { display: none; }
    .mobile-break { display: block; }
    .manifesto, .section-heading, .about, .contact { grid-template-columns: 1fr; }
    .manifesto-copy, .manifesto-note, .contact-intro, .contact-form { grid-column: 1; }
    .section-heading { margin-bottom: 55px; }
    .service { grid-template-columns: .25fr 1fr; }
    .service > p, .service ul { grid-column: 2; }
    .project { grid-template-columns: .25fr 1fr auto; padding: 26px 0; }
    .project p { grid-column: 2; }
    .project time { grid-column: 3; grid-row: 1; }
    .project b { display: none; }
    .about-mark { display: none; }
    .about-copy h2 { margin: 35px 0 42px; }
    .contact { gap: 45px; }
    .contact-form { grid-template-columns: 1fr; }
    .contact-form .full { grid-column: 1; }
    footer > img { width: 90vw; }
    footer > div { align-items: flex-start; flex-direction: column; gap: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition-duration: .01ms !important; }
  }
</style>
